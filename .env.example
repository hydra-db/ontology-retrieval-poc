# Copy to .env (it is git-ignored). `orp` reads it from the current directory.

# Where the API stores everything.
ORP_DB=data/orp.db

# The API the hook and `orp backfill` upload to.
ORP_API_URL=http://localhost:8765
# Your user's key. If unset, ~/.orp/key is used.
# ORP_API_KEY=

# The model endpoint the analyzer and organizer call (OpenAI-compatible, e.g. vLLM on RunPod).
ORP_LLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
ORP_LLM_API_KEY=
ORP_ANALYZER_MODEL=Qwen/Qwen3.6-35B-A3B
# Optional: a different model for the organizer.
# ORP_ORGANIZER_MODEL=
